#################### Custom.gitignore ####################


#################### Git.gitignore ####################

# add your custom gitignore here:
!.gitignore
!.gitsubmodules

#################### Windows.gitignore ####################

# Windows thumbnail cache files
Thumbs.db*
ehthumbs*.db

# Dump file
*.stackdump

# Folder config file
[Dd]esktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msix
*.msm
*.msp

# Windows shortcuts
*.lnk

# Office 打开文件时生成的临时锁文件（~$报告.docx 这种）
~$*

#################### macOS.gitignore ####################

# General
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Finder 给每个目录放的本地化标记
.localized

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
__MACOSX

#################### Linux.gitignore ####################

.Trash-*
*~
.nfs*

#################### Editor.gitignore ####################

# VS Code
.vscode/

# JetBrains 全家桶（IntelliJ、PyCharm、WebStorm 等）
.idea/

# Vim 的交换文件和备份
*.swp
*.swo
*.swn

# VS Code 的本地历史记录
.history/

#################### Backup.gitignore ####################

# Backup and temporary files
*.bak
*.gho
*.ori
*.orig
*.tmp
*.log

# Temporary directory
tmp/
temp/
.cache/

#################### Python.gitignore ####################

# 字节码缓存
__pycache__/
*.py[cod]

# 虚拟环境
.venv/
venv/

# 环境变量（可能含密钥，绝不能提交）
.env

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# 代码检查工具的缓存
.ruff_cache/
.mypy_cache/

# 打包产物
*.egg-info/
build/
dist/